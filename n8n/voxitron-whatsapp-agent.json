{
  "name": "Voxitron WhatsApp Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "voxitron/whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1600, -320],
      "id": "verify-webhook",
      "name": "Meta Verify Webhook",
      "webhookId": "voxitron-wa-verify"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "verify-token-match",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.VOXITRON_WA_VERIFY_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-1392, -320],
      "id": "check-verify-token",
      "name": "Verify Token Matches?"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": { "responseCode": 200 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [-1184, -384],
      "id": "respond-challenge",
      "name": "Respond With Challenge"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": { "responseCode": 403 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [-1184, -256],
      "id": "respond-forbidden",
      "name": "Respond Forbidden"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voxitron/whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1600, 0],
      "id": "receive-message",
      "name": "Receive WhatsApp Message",
      "webhookId": "voxitron-wa-receive"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": { "responseCode": 200 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [-1392, 0],
      "id": "ack-immediately",
      "name": "Acknowledge Immediately",
      "notes": "Meta requires a 200 within a few seconds or it retries/disables the webhook. Ack first, then keep processing in the background execution."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 3 },
          "conditions": [
            {
              "id": "has-message",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages }}",
              "rightValue": "",
              "operator": { "type": "array", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-1392, 128],
      "id": "has-inbound-message",
      "name": "Has Inbound Message?",
      "notes": "Meta also sends 'statuses' webhook events (delivered/read receipts) on the same path. Only proceed for actual inbound messages, ignore status callbacks."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "phone-number-id",
              "name": "phoneNumberId",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.metadata.phone_number_id }}"
            },
            {
              "id": "from",
              "name": "fromNumber",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.messages[0].from }}"
            },
            {
              "id": "contact-name",
              "name": "contactName",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.contacts[0]?.profile?.name || '' }}"
            },
            {
              "id": "message-text",
              "name": "messageText",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.messages[0].text?.body || '' }}"
            },
            {
              "id": "wa-message-id",
              "name": "waMessageId",
              "type": "string",
              "value": "={{ $json.body.entry[0].changes[0].value.messages[0].id }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1184, 128],
      "id": "extract-message-fields",
      "name": "Extract Message Fields"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, business_name, whatsapp_number\nFROM customers\nWHERE whatsapp_number = $1\n",
        "options": {
          "queryReplacement": "={{ $json.phoneNumberId }}",
          "replaceEmptyStrings": true
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-976, 128],
      "id": "load-customer",
      "name": "Load Customer by Number",
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_CREDENTIAL_ID", "name": "Postgres - Supabase Voxitron (service role)" }
      },
      "notes": "phone_number_id from Meta's payload must match customers.whatsapp_number exactly. Store the same value used when the customer's number was provisioned in Meta."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 3 },
          "conditions": [
            {
              "id": "customer-found",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [-768, 128],
      "id": "customer-found-check",
      "name": "Customer Found?",
      "notes": "If no customer row matches this WhatsApp number, stop. Don't guess or default to some other customer's data."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversations (customer_id, contact_name, contact_phone)\nSELECT $1::uuid, $2, $3\nWHERE NOT EXISTS (\n  SELECT 1 FROM conversations\n  WHERE customer_id = $1::uuid AND contact_phone = $3\n)\nRETURNING id;\n\nSELECT id FROM conversations\nWHERE customer_id = $1::uuid AND contact_phone = $3\nORDER BY started_at DESC\nLIMIT 1;\n",
        "options": {
          "queryReplacement": "={{ $('Load Customer by Number').item.json.id }},{{ $('Extract Message Fields').item.json.contactName }},{{ $('Extract Message Fields').item.json.fromNumber }}",
          "replaceEmptyStrings": true
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-560, 64],
      "id": "get-or-create-conversation",
      "name": "Get or Create Conversation",
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_CREDENTIAL_ID", "name": "Postgres - Supabase Voxitron (service role)" }
      },
      "notes": "One conversation row per (customer, contact_phone) pair. Reuses the existing thread instead of creating a new one per message."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, direction, body)\nVALUES ($1::uuid, 'inbound', $2)\n",
        "options": {
          "queryReplacement": "={{ $('Get or Create Conversation').item.json.id }},{{ $('Extract Message Fields').item.json.messageText }}",
          "replaceEmptyStrings": true
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-352, 64],
      "id": "log-inbound-message",
      "name": "Log Inbound Message",
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_CREDENTIAL_ID", "name": "Postgres - Supabase Voxitron (service role)" }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Extract Message Fields').item.json.messageText }}",
        "options": {
          "systemMessage": "=You are the WhatsApp assistant for {{ $('Load Customer by Number').item.json.business_name }}, a Voxitron customer.\n\nAlways search the knowledge base before answering. Only answer from verified knowledge base content, never guess prices, stock, or policies. If the answer isn't in the knowledge base, say you'll have someone from the team follow up.\n\nWrite like a real person texting on WhatsApp: short sentences, no markdown formatting, no bullet points, no em dashes. Two to three sentences per reply unless the question genuinely needs more."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [-144, 64],
      "id": "ai-agent-reply",
      "name": "AI Agent Reply"
    },
    {
      "parameters": {
        "model": { "__rl": true, "value": "gpt-4o", "mode": "list", "cachedResultName": "gpt-4o" },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [-256, 240],
      "id": "openai-chat-model",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": { "id": "REPLACE_WITH_OPENAI_CREDENTIAL_ID", "name": "OpenAi account" }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search this business's knowledge base (products, pricing, policies) to answer the customer's question. Always use this before replying.",
        "qdrantCollection": {
          "__rl": true,
          "value": "=kb_{{ $('Load Customer by Number').item.json.id }}",
          "mode": "id"
        },
        "topK": 5,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [-32, 240],
      "id": "qdrant-kb-search",
      "name": "Qdrant Vector Store",
      "credentials": {
        "qdrantApi": { "id": "REPLACE_WITH_QDRANT_CREDENTIAL_ID", "name": "QdrantApi account" }
      },
      "notes": "Collection is namespaced per Voxitron customer (kb_<customers.id>), same pattern as Area50's WF1/WF5/WF6. A separate ingest workflow (mirroring Area50's WF5) is needed later to actually populate each customer's collection with their product/pricing docs. Not built yet, out of scope for this logging-focused pass."
    },
    {
      "parameters": {
        "model": "text-embedding-ada-002",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [-160, 384],
      "id": "embeddings-openai",
      "name": "Embeddings OpenAI",
      "credentials": {
        "openAiApi": { "id": "REPLACE_WITH_OPENAI_CREDENTIAL_ID", "name": "OpenAi account" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Extract Message Fields').item.json.phoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extract Message Fields').item.json.fromNumber }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"{{ $('AI Agent Reply').item.json.output }}\" }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [128, 64],
      "id": "send-whatsapp-reply",
      "name": "Send WhatsApp Reply",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_META_ACCESS_TOKEN_CREDENTIAL_ID", "name": "WhatsApp Cloud API token" }
      },
      "notes": "Header credential should send 'Authorization: Bearer <permanent Meta access token>'. Token is per Meta app, not per customer, since all customer numbers are typically under one Meta Business Account / WABA."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, direction, body)\nVALUES ($1::uuid, 'outbound', $2)\n",
        "options": {
          "queryReplacement": "={{ $('Get or Create Conversation').item.json.id }},{{ $('AI Agent Reply').item.json.output }}",
          "replaceEmptyStrings": true
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [320, 64],
      "id": "log-outbound-message",
      "name": "Log Outbound Message",
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_CREDENTIAL_ID", "name": "Postgres - Supabase Voxitron (service role)" }
      }
    }
  ],
